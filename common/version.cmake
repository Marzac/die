# DIE ENGINE - build version header, read from git
#
# Usage: cmake -DSOURCE_DIR=<repository> -DOUTPUT=<header> -P version.cmake
#
# Version tags are named vX.Y-name (v1.2-uneven-walls): the version is the tag up
# to its first "-". The header is only rewritten when its content changes, so a
# build with no new commit recompiles nothing. Without git or tags the fields read
# "unknown": the build never fails on it.

if(NOT SOURCE_DIR OR NOT OUTPUT)
    message(FATAL_ERROR "version.cmake: SOURCE_DIR and OUTPUT must be set")
endif()

set(BUILD_TAG "unknown")
set(BUILD_VERSION "unknown")
set(BUILD_COMMIT "unknown")
set(BUILD_AHEAD 0)
set(BUILD_DIRTY 0)

if(NOT GIT_EXECUTABLE)
    find_program(GIT_EXECUTABLE NAMES git
        HINTS "C:/Program Files/Git/cmd" "C:/Program Files/Git/bin")
endif()

function(git_query out)
    execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN}
        WORKING_DIRECTORY "${SOURCE_DIR}"
        RESULT_VARIABLE res
        OUTPUT_VARIABLE text
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(res EQUAL 0)
        set(${out} "${text}" PARENT_SCOPE)
    else()
        set(${out} "" PARENT_SCOPE)
    endif()
endfunction()

if(GIT_EXECUTABLE)
    git_query(commit rev-parse --short=7 HEAD)
    if(NOT commit STREQUAL "")
        set(BUILD_COMMIT "${commit}")

        git_query(tag describe --tags --abbrev=0 --match "v*" HEAD)
        if(NOT tag STREQUAL "")
            set(BUILD_TAG "${tag}")
            string(REGEX MATCH "^[^-]+" BUILD_VERSION "${tag}")
            git_query(ahead rev-list --count "${tag}..HEAD")
            if(NOT ahead STREQUAL "")
                set(BUILD_AHEAD ${ahead})
            endif()
        endif()

    # Modified tracked files only: untracked files (build outputs, scratch) do not count
        git_query(changes status --porcelain --untracked-files=no)
        if(NOT changes STREQUAL "")
            set(BUILD_DIRTY 1)
        endif()
    endif()
endif()

string(TIMESTAMP BUILD_DATE "%d.%m.%y")

set(content "// Generated by common/version.cmake at build time, do not edit\n")
string(APPEND content "#pragma once\n\n")
string(APPEND content "#define BUILD_TAG     \"${BUILD_TAG}\"\n")
string(APPEND content "#define BUILD_VERSION \"${BUILD_VERSION}\"\n")
string(APPEND content "#define BUILD_COMMIT  \"${BUILD_COMMIT}\"\n")
string(APPEND content "#define BUILD_AHEAD   ${BUILD_AHEAD}\n")
string(APPEND content "#define BUILD_DIRTY   ${BUILD_DIRTY}\n")
string(APPEND content "#define BUILD_DATE    \"${BUILD_DATE}\"\n")

set(previous "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
